{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "server": "deno run --allow-net --allow-env server/main.ts",
    "client": "deno run --allow-net --allow-env client/bridge.ts",
    "compile:win": "deno compile --target x86_64-pc-windows-msvc --allow-net --allow-env --output dist/bridge-windows.exe client/bridge.ts",
    "compile:mac-arm": "deno compile --target aarch64-apple-darwin --allow-net --allow-env --output dist/bridge-mac-arm client/bridge.ts",
    "compile:mac-x64": "deno compile --target x86_64-apple-darwin --allow-net --allow-env --output dist/bridge-mac-x64 client/bridge.ts",
    "compile:linux": "deno compile --target x86_64-unknown-linux-gnu --allow-net --allow-env --output dist/bridge-linux client/bridge.ts",
    "compile:all": "deno task compile:win && deno task compile:mac-arm && deno task compile:mac-x64 && deno task compile:linux"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}

